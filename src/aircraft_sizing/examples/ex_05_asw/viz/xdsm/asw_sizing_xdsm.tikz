\input{"C:/Users/darsh/miniconda3/Lib/site-packages/pyxdsm/diagram_styles"}
\begin{tikzpicture}

\matrix[MatrixSetup]{
%Row 0
\node [DataIO] (output_solver) {$\begin{array}{c}W_{TO}^{(0)} \\ \varepsilon_{\text{conv}}\end{array}$};&
\node [DataIO] (output_fuel) {$\begin{array}{c}\text{mission data} \\ M, R, E \\ L/D, \mathrm{sfc} \\ \text{fuel allowances}\end{array}$};&
\node [DataIO] (output_empty) {$0.93\,W_{TO}^{-0.07}$};&
\node [DataIO] (output_update) {$W_{\text{fixed}} = 10{,}800~\mathrm{lb}$};&
&
\\
%Row 1
\node [MDA] (solver) {$\begin{array}{c}\text{Fixed-point} \\ \text{solver}\end{array}$};&
&
\node [DataInter] (solver-empty) {$W_{TO}^{(k)}$};&
&
&
\node [DataIO] (right_output_solver) {$W_{TO}^{*}$};\\
%Row 2
&
\node [Function] (fuel) {$\begin{array}{c}\text{Mission fuel-} \\ \text{fraction analysis}\end{array}$};&
&
\node [DataInter] (fuel-update) {$W_f / W_{TO}$};&
&
\\
%Row 3
&
&
\node [Function] (empty) {$\begin{array}{c}\text{Empty-weight} \\ \text{fraction analysis}\end{array}$};&
\node [DataInter] (empty-update) {$W_e / W_{TO}$};&
&
\\
%Row 4
\node [DataInter] (update-solver) {$W_{TO}^{(k+1)}$};&
&
&
\node [Function] (update) {$\begin{array}{c}\text{TOGW} \\ \text{update}\end{array}$};&
&
\\
%Row 5
&
&
&
&
&
\\
};

% XDSM process chains
{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (output_fuel);
\chainin (fuel) [join=by ProcessTipA];
\chainin (update) [join=by ProcessHVA];
\end{pgfonlayer}
}{ [start chain=process]
 \begin{pgfonlayer}{process} 
\chainin (output_solver);
\chainin (solver) [join=by ProcessTipA];
\chainin (empty) [join=by ProcessHVA];
\chainin (update) [join=by ProcessHVA];
\chainin (solver) [join=by ProcessHVA];
\end{pgfonlayer}
}

\begin{pgfonlayer}{data}
\path
% Horizontal edges
(solver) edge [DataLine] (solver-empty)
(fuel) edge [DataLine] (fuel-update)
(empty) edge [DataLine] (empty-update)
(update) edge [DataLine] (update-solver)
(solver) edge [DataLine] (right_output_solver)
% Vertical edges
(solver-empty) edge [DataLine] (empty)
(fuel-update) edge [DataLine] (update)
(empty-update) edge [DataLine] (update)
(update-solver) edge [DataLine] (solver)
(solver) edge [DataLine] (output_solver)
(fuel) edge [DataLine] (output_fuel)
(empty) edge [DataLine] (output_empty)
(update) edge [DataLine] (output_update);
\end{pgfonlayer}

\end{tikzpicture}
